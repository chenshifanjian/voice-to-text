doctor_check() {
  local label="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    printf 'ok   %s\n' "$label"
    return 0
  fi
  printf 'fail %s\n' "$label"
  return 1
}

doctor() {
  local failed=0

  printf 'voice-to-text doctor\n'
  printf 'Data dir: %s\n' "$DATA_DIR"
  printf 'Config dir: %s\n' "$CONFIG_DIR"
  printf 'Runtime dir: %s\n' "$TMP_DIR"

  doctor_check "ffmpeg" command -v ffmpeg || failed=1
  if [ "$AUDIO_FORMAT" = "pulse" ]; then
    if command -v pactl >/dev/null 2>&1 || command -v wpctl >/dev/null 2>&1; then
      printf 'ok   PulseAudio/PipeWire tools\n'
    else
      printf 'warn PulseAudio/PipeWire tools not found\n'
    fi
  fi
  if has_clipboard_backend; then
    printf 'ok   clipboard backend\n'
  else
    printf 'fail clipboard backend\n'
    failed=1
  fi
  if sensevoice_available; then
    printf 'ok   SenseVoice venv: %s\n' "$SV_VENV_DIR/bin/python"
  else
    printf 'info SenseVoice not installed\n'
  fi
  if [ -x "$VENV_DIR/bin/python" ] && "$VENV_DIR/bin/python" -c 'import faster_whisper, zhconv' >/dev/null 2>&1; then
    printf 'ok   whisper venv: %s\n' "$VENV_DIR/bin/python"
  elif python3 -c 'import faster_whisper' >/dev/null 2>&1; then
    printf 'ok   system python faster-whisper\n'
  elif command -v whisper >/dev/null 2>&1; then
    printf 'ok   whisper CLI\n'
  else
    printf 'info whisper backend not installed\n'
  fi
  if [ "$BACKEND" = "sensevoice" ] && ! sensevoice_available; then
    printf 'fail backend=sensevoice is not installed\n'
    failed=1
  fi
  if [ "$BACKEND" = "whisper" ] && ! whisper_available; then
    printf 'fail backend=whisper is not installed\n'
    failed=1
  fi
  if [ "$(resolve_backend)" = "sensevoice" ]; then
    printf 'info selected backend: sensevoice (%s)\n' "$(sensevoice_model_dir)"
  elif whisper_available; then
    printf 'info selected backend: whisper (%s)\n' "$MODEL"
  else
    printf 'fail no usable ASR backend\n'
    failed=1
  fi
  [ -f "$BUILTIN_TERMS_FILE" ] && printf 'ok   built-in terms\n' || printf 'warn built-in terms missing\n'
  [ -f "$BUILTIN_REPLACEMENTS_FILE" ] && printf 'ok   built-in replacements\n' || printf 'warn built-in replacements missing\n'
  [ -f "$TERMS_FILE" ] && printf 'ok   user terms\n' || printf 'info user terms not initialized\n'
  [ -f "$REPLACEMENTS_FILE" ] && printf 'ok   user replacements\n' || printf 'info user replacements not initialized\n'

  case "$BEAM_SIZE" in
    ''|*[!0-9]*|0) printf 'fail VOICE_TO_TEXT_BEAM_SIZE\n'; failed=1 ;;
    *) printf 'ok   VOICE_TO_TEXT_BEAM_SIZE=%s\n' "$BEAM_SIZE" ;;
  esac
  case "$TERMS_LIMIT" in
    ''|*[!0-9]*) printf 'fail VOICE_TO_TEXT_TERMS_LIMIT\n'; failed=1 ;;
    *) printf 'ok   VOICE_TO_TEXT_TERMS_LIMIT=%s\n' "$TERMS_LIMIT" ;;
  esac
  case "$HISTORY_LIMIT" in
    ''|*[!0-9]*) printf 'fail VOICE_TO_TEXT_HISTORY_LIMIT\n'; failed=1 ;;
    *) printf 'ok   VOICE_TO_TEXT_HISTORY_LIMIT=%s\n' "$HISTORY_LIMIT" ;;
  esac

  [ "$failed" -eq 0 ] || return 1
}

append_history() {
  local text="$1"
  local tmp_file clean_text

  [ "$HISTORY_LIMIT" -gt 0 ] || return 0
  mkdir -p "$(dirname "$HISTORY_FILE")"
  clean_text="$(printf '%s' "$text" | tr '\t\n' '  ')"
  printf '%s\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S%z)" "$clean_text" >> "$HISTORY_FILE"
  tmp_file="$HISTORY_FILE.tmp.$$"
  tail -n "$HISTORY_LIMIT" "$HISTORY_FILE" > "$tmp_file" && mv "$tmp_file" "$HISTORY_FILE"
  rm -f "$tmp_file" >/dev/null 2>&1 || true
}

show_history() {
  if [ ! -s "$HISTORY_FILE" ]; then
    printf 'No history yet.\n'
    return 0
  fi
  awk -F '\t' '{ printf "%d. [%s] %s\n", NR, $1, $2 }' "$HISTORY_FILE"
}

last_history_text() {
  local line=""
  [ -s "$HISTORY_FILE" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do :; done < "$HISTORY_FILE"
  [ -n "$line" ] || return 1
  printf '%s' "${line#*$'\t'}"
}

usage() {
  cat <<'EOF'
Usage: voice-to-text [command]

Commands:
  --setup        Install or update the local ASR backends (SenseVoice + whisper)
  --check        Check required runtime dependencies
  --doctor       Print a fuller diagnostic report
  --init-config  Create personal terms and correction files
  --history      Show recent transcripts
  --copy-last    Copy the latest transcript to the clipboard
  --help         Show this help

Run without a command to record, transcribe, and copy text.

Environment:
  VOICE_TO_TEXT_BACKEND=auto|sensevoice|whisper  ASR backend (default: auto)
  VOICE_TO_TEXT_SENSEVOICE_MODEL=<model>         SenseVoice model (default: iic/SenseVoiceSmall)
  VOICE_TO_TEXT_SENSEVOICE_THREADS=<n>           ONNX inference threads (default: 4)
  VOICE_TO_TEXT_SENSEVOICE_MAX_SEGMENT=<secs>    Split longer recordings at pauses (default: 25)
  VOICE_TO_TEXT_MODEL=<model>                    whisper model (default: medium)
  VOICE_TO_TEXT_LANGUAGE=<lang>                  auto, zh, en, yue, ja, ko (default: auto)
  VOICE_TO_TEXT_UI=auto|gtk|zenity|none          界面后端 (default: auto)
  VOICE_TO_TEXT_MAX_SECONDS=<secs>               单次录音最长时长 (default: 3600)
  VOICE_TO_TEXT_KEEP_FILES=<n>                   运行目录保留最近 N 份录音/转写 (default: 20)
  VOICE_TO_TEXT_THEME=auto|dark|light            界面主题 (default: auto)
EOF
}

copy_text() {
  local text="$1"
  if command -v wl-copy >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
    wl-copy --trim-newline "$text" >/dev/null 2>&1 &
  elif command -v xclip >/dev/null 2>&1; then
    printf '%s' "$text" | xclip -selection clipboard >/dev/null 2>&1 &
  elif command -v xsel >/dev/null 2>&1; then
    printf '%s' "$text" | xsel --clipboard --input >/dev/null 2>&1 &
  else
    return 1
  fi
}

ui_helper_path() {
  local candidate

  for candidate in "$DATA_DIR/voice-to-text-ui.py" "$SCRIPT_DIR/data/voice-to-text-ui.py"; do
    if [ -f "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

# GTK4 界面可用性预检：没有 gobject/Gtk4 或连不上显示服务器就走兜底对话框。

has_gtk4_ui() {
  command -v python3 >/dev/null 2>&1 || return 1
  python3 - <<'PY' >/dev/null 2>&1
import sys

try:
    import gi

    gi.require_version("Gtk", "4.0")
    from gi.repository import Gdk, Gtk
except Exception:
    sys.exit(1)

Gtk.init()
sys.exit(0 if Gdk.Display.get_default() is not None else 1)
PY
}

# 界面后端只解析一次：auto = GTK → zenity → 终端；也可以用
# VOICE_TO_TEXT_UI=gtk|zenity|none 指定。显式指定时跳过 GTK 预检
# （预检要 ~0.15 秒，既然指定了就直接试）。
resolve_ui_backend() {
  [ -n "$UI_BACKEND" ] && { printf '%s' "$UI_BACKEND"; return 0; }
  case "$UI_MODE" in
    gtk|zenity|none) UI_BACKEND="$UI_MODE" ;;
    *)
      if has_graphical_session && has_gtk4_ui; then
        UI_BACKEND=gtk
      elif has_graphical_session && command -v zenity >/dev/null 2>&1; then
        UI_BACKEND=zenity
      else
        UI_BACKEND=none
      fi
      ;;
  esac
  printf '%s' "$UI_BACKEND"
}

# 录音进度窗：GTK4 HUD（跟随系统缩放/主题）→ zenity → 终端回车。

show_recording_dialog() {
  local ui_helper backend
  backend="$(resolve_ui_backend)"

  if [ "$backend" = gtk ] && ui_helper="$(ui_helper_path)"; then
    local rc=0 start="${EPOCHREALTIME:-0}" end
    python3 "$ui_helper" record --pid "$ffmpeg_pid" --format "$AUDIO_FORMAT" --source "$AUDIO_SOURCE" || rc=$?
    end="${EPOCHREALTIME:-0}"
    # 录音窗活过 1 秒就说明它正常起来了：此时它非零退出＝被关掉/被杀，
    # 同样按「停止录音」处理，不要弹一个骗人的「界面未能启动」再塞个 zenity 挡路。
    if [ "$rc" -eq 0 ] || awk -v a="$start" -v b="$end" 'BEGIN { exit !(b - a >= 1) }'; then
      return 0
    fi
    printf '语贴界面未能启动（退出码 %s），改用系统对话框。\n' "$rc" >&2
  fi

  if { [ "$backend" = gtk ] || [ "$backend" = zenity ]; } && command -v zenity >/dev/null 2>&1 && has_graphical_session; then
    zenity --progress --title="$APP_NAME" --text="准备录音..." --percentage=50 --pulsate --cancel-label="停止录音" >/dev/null 2>&1 || true
    return
  fi

  printf '正在录音（界面模式：%s）。按 Enter 停止...\n' "$backend" >&2
  read -r _ || true
}

# 识别结果窗：GTK4 卡片（可复制/自动关闭）→ zenity → 直接打印。

show_result_dialog() {
  local transcript_file="$1"
  local ui_helper backend
  backend="$(resolve_ui_backend)"

  if [ "$backend" = gtk ] && ui_helper="$(ui_helper_path)"; then
    local rc=0 start="${EPOCHREALTIME:-0}" end
    python3 "$ui_helper" result "$transcript_file" || rc=$?
    end="${EPOCHREALTIME:-0}"
    if [ "$rc" -eq 0 ] || awk -v a="$start" -v b="$end" 'BEGIN { exit !(b - a >= 1) }'; then
      return 0
    fi
    printf '语贴界面未能启动（退出码 %s），改用系统对话框。\n' "$rc" >&2
  fi

  if { [ "$backend" = gtk ] || [ "$backend" = zenity ]; } && command -v zenity >/dev/null 2>&1 && has_graphical_session; then
    zenity --info --title="$APP_NAME" --text="已复制到剪贴板：\n\n$(sed -n '1,20p' "$transcript_file")" --ok-label="关闭" >/dev/null 2>&1 || true
  else
    sed -n '1,$p' "$transcript_file"
  fi
}

case "${1:-}" in
  --setup)
    setup_backend
    exit 0
    ;;
  --check)
    check_environment
    exit 0
    ;;
  --doctor)
    doctor
    exit $?
    ;;
  --init-config)
    init_config
    exit 0
    ;;
  --history)
    show_history
    exit 0
    ;;
  --copy-last)
    has_clipboard_backend || die "缺少剪贴板工具：Wayland 需要 wl-clipboard，X11 需要 xclip 或 xsel。"
    text="$(last_history_text)" || die "还没有历史记录。"
    copy_text "$text" || die "复制到剪贴板失败。"
    printf '%s\n' "$text"
    exit 0
    ;;
  --help|-h)
    usage
    exit 0
    ;;
  --*)
    usage >&2
    exit 2
    ;;
esac

transcribe_with_python_faster_whisper() {
  local audio_file="$1"
  local prompt="$2"
  local hotwords="$3"
  python3 - "$audio_file" "$MODEL" "$LANGUAGE" "$BEAM_SIZE" "$prompt" "$hotwords" "$BUILTIN_REPLACEMENTS_FILE" "$REPLACEMENTS_FILE" <<'PY'
import sys
import re
import os
from pathlib import Path
from faster_whisper import WhisperModel

audio_file, model_name, language, beam_size, initial_prompt, hotwords = sys.argv[1:7]
replacement_files = sys.argv[7:]

def resolve_model(model_name):
    model_path = Path(model_name).expanduser()
    if model_path.exists():
        return str(model_path), True

    repo_name = model_name
    if "/" not in repo_name:
        repo_name = f"Systran/faster-whisper-{repo_name}"
    cache_name = "models--" + repo_name.replace("/", "--")
    if os.environ.get("HUGGINGFACE_HUB_CACHE"):
        hub_cache = Path(os.environ["HUGGINGFACE_HUB_CACHE"]).expanduser()
    elif os.environ.get("HF_HOME"):
        hub_cache = Path(os.environ["HF_HOME"]).expanduser() / "hub"
    else:
        cache_home = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")).expanduser()
        hub_cache = cache_home / "huggingface" / "hub"
    snapshots = hub_cache / cache_name / "snapshots"
    if snapshots.exists():
        cached = sorted(
            (
                path
                for path in snapshots.iterdir()
                if path.is_dir() and (path / "model.bin").is_file() and (path / "config.json").is_file()
            ),
            key=lambda path: path.stat().st_mtime,
        )
        if cached:
            return str(cached[-1]), True
    return model_name, False

def apply_replacements(text):
    for replacement_file in replacement_files:
        try:
            with open(replacement_file, "r", encoding="utf-8") as handle:
                for raw_line in handle:
                    line = raw_line.strip()
                    if not line or line.startswith("#") or "\t" not in line:
                        continue
                    source, target = line.split("\t", 1)
                    if source:
                        text = text.replace(source, target)
        except FileNotFoundError:
            continue
    if len(re.findall(r'(?<![A-Za-z])Z(?=\d)', text)) >= 2:
        text = re.sub(r'(?<![A-Za-z])Z(?=\d)', '', text)
    tokens = re.findall(r'[A-Za-z]+(?:[-_][A-Za-z0-9]+)*\d*|\d+|[\u4e00-\u9fff]+|[^\w\s]', text)
    if tokens:
        compact = [token.upper() for token in tokens if re.search(r'[A-Za-z0-9\u4e00-\u9fff]', token)]
        for size in range(1, 4):
            if len(compact) >= size * 6:
                chunks = [tuple(compact[i:i + size]) for i in range(0, min(len(compact), size * 8), size)]
                if len(chunks) >= 6 and len(set(chunks[:6])) <= 2:
                    return ''
    text = re.sub(r'\b([A-Z]{2,5})(?:[- ]?\d)?\b(?:[,，、\s]+\b\1(?:[- ]?\d)?\b){4,}', '', text).strip(' ,，、')
    return text

resolved_model, local_only = resolve_model(model_name)
model = WhisperModel(resolved_model, device="cpu", compute_type="int8", local_files_only=local_only)
kwargs = {
    "vad_filter": True,
    "vad_parameters": dict(
        min_silence_duration_ms=500,
        speech_pad_ms=200,
    ),
    "beam_size": int(beam_size),
    "temperature": [0.0, 0.2, 0.4],
    "repetition_penalty": 1.2,
    "no_repeat_ngram_size": 3,
    "no_speech_threshold": 0.4,
    "hallucination_silence_threshold": 2.0,
    "condition_on_previous_text": False,
    "initial_prompt": initial_prompt or None,
    "hotwords": hotwords or None,
}
if language != "auto":
    kwargs["language"] = language
segments, _ = model.transcribe(audio_file, **kwargs)
text = "".join(segment.text for segment in segments).strip()
try:
    from zhconv import convert
    text = convert(text, "zh-cn")
except Exception:
    pass
text = apply_replacements(text)
print(text)
PY
}

transcribe_with_sensevoice() {
  local audio_file="$1"
  local segment_dir="$TMP_DIR/sensevoice-segments-$$"
  local segs=()
  local index=0 start end segment_file language

  language="$(sensevoice_language)"

  while read -r start end; do
    if [ "$end" = "-1" ]; then
      segs+=("$audio_file")
      continue
    fi
    mkdir -p "$segment_dir"
    segment_file="$segment_dir/segment-$index.wav"
    ffmpeg -hide_banner -loglevel error -y -ss "$start" -to "$end" -i "$audio_file" -ac 1 -ar 16000 "$segment_file" \
      || die "把录音切成 $SV_MAX_SEGMENT 秒分段时失败。"
    segs+=("$segment_file")
    index=$((index + 1))
  done < <(plan_audio_segments "$audio_file")

  if [ "${#segs[@]}" -eq 0 ]; then
    segs=("$audio_file")
  fi

  "$SV_VENV_DIR/bin/python" - "$(sensevoice_model_dir)" "$SV_THREADS" "$language" "$BUILTIN_REPLACEMENTS_FILE" "$REPLACEMENTS_FILE" "${segs[@]}" <<'PY'
import re
import sys

model_dir, threads, language, builtin_replacements, user_replacements = sys.argv[1:6]
replacement_files = [builtin_replacements, user_replacements]
audio_files = sys.argv[6:]

def apply_replacements(text):
    for replacement_file in replacement_files:
        try:
            with open(replacement_file, "r", encoding="utf-8") as handle:
                for raw_line in handle:
                    line = raw_line.strip()
                    if not line or line.startswith("#") or "\t" not in line:
                        continue
                    source, target = line.split("\t", 1)
                    if source:
                        text = text.replace(source, target)
        except FileNotFoundError:
            continue
    if len(re.findall(r'(?<![A-Za-z])Z(?=\d)', text)) >= 2:
        text = re.sub(r'(?<![A-Za-z])Z(?=\d)', '', text)
    tokens = re.findall(r'[A-Za-z]+(?:[-_][A-Za-z0-9]+)*\d*|\d+|[\u4e00-\u9fff]+|[^\w\s]', text)
    if tokens:
        compact = [token.upper() for token in tokens if re.search(r'[A-Za-z0-9\u4e00-\u9fff]', token)]
        for size in range(1, 4):
            if len(compact) >= size * 6:
                chunks = [tuple(compact[i:i + size]) for i in range(0, min(len(compact), size * 8), size)]
                if len(chunks) >= 6 and len(set(chunks[:6])) <= 2:
                    return ''
    text = re.sub(r'\b([A-Z]{2,5})(?:[- ]?\d)?\b(?:[,，、\s]+\b\1(?:[- ]?\d)?\b){4,}', '', text).strip(' ,，、')
    return text

def strip_tags(text):
    return re.sub(r"<\|[^|]*\|>", "", text).strip()

from funasr_onnx import SenseVoiceSmall

model = SenseVoiceSmall(
    model_dir=model_dir,
    quantize=True,
    batch_size=1,
    intra_op_num_threads=int(threads),
)

chunks = []
for audio_file in audio_files:
    result = model(audio_file, language=language, textnorm="withitn")
    if isinstance(result, list):
        raw = result[0] if result else ""
    elif isinstance(result, dict):
        raw = result.get("text", "")
    else:
        raw = result
    raw = strip_tags(str(raw))
    if raw:
        chunks.append(raw)

PUNCT = "。！？，、；：,.!?;:\u2026\u2014）)】」』"
if len(chunks) > 1:
    # 分段边界上 SenseVoice 有时两段都带标点（如「内容。」+「。比如」），
    # 直接拼会得到「。。」；只在这种重复标点的情况下丢掉后一段开头那个。
    joined = chunks[0].rstrip()
    for chunk in chunks[1:]:
        chunk = chunk.lstrip()
        if joined and chunk and joined[-1] in PUNCT and chunk[0] in PUNCT:
            chunk = chunk[1:].lstrip()
        joined += chunk
    text = joined.strip()
else:
    text = "".join(chunks).strip()
try:
    from zhconv import convert
    text = convert(text, "zh-cn")
except Exception:
    pass
text = apply_replacements(text)
print(text)
PY
  rm -rf "$segment_dir" >/dev/null 2>&1 || true
}

transcribe() {
  local audio_file="$1"
  local prompt="$2"
  local hotwords="$3"

  if [ "$(resolve_backend)" = "sensevoice" ]; then
    transcribe_with_sensevoice "$audio_file"
    return
  fi

  if [ -x "$VENV_DIR/bin/python" ] && "$VENV_DIR/bin/python" -c 'import faster_whisper' >/dev/null 2>&1; then
    "$VENV_DIR/bin/python" - "$audio_file" "$MODEL" "$LANGUAGE" "$BEAM_SIZE" "$prompt" "$hotwords" "$BUILTIN_REPLACEMENTS_FILE" "$REPLACEMENTS_FILE" <<'PY'
import sys
import re
import os
from pathlib import Path
from faster_whisper import WhisperModel

audio_file, model_name, language, beam_size, initial_prompt, hotwords = sys.argv[1:7]
replacement_files = sys.argv[7:]

def resolve_model(model_name):
    model_path = Path(model_name).expanduser()
    if model_path.exists():
        return str(model_path), True

    repo_name = model_name
    if "/" not in repo_name:
        repo_name = f"Systran/faster-whisper-{repo_name}"
    cache_name = "models--" + repo_name.replace("/", "--")
    if os.environ.get("HUGGINGFACE_HUB_CACHE"):
        hub_cache = Path(os.environ["HUGGINGFACE_HUB_CACHE"]).expanduser()
    elif os.environ.get("HF_HOME"):
        hub_cache = Path(os.environ["HF_HOME"]).expanduser() / "hub"
    else:
        cache_home = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")).expanduser()
        hub_cache = cache_home / "huggingface" / "hub"
    snapshots = hub_cache / cache_name / "snapshots"
    if snapshots.exists():
        cached = sorted(
            (
                path
                for path in snapshots.iterdir()
                if path.is_dir() and (path / "model.bin").is_file() and (path / "config.json").is_file()
            ),
            key=lambda path: path.stat().st_mtime,
        )
        if cached:
            return str(cached[-1]), True
    return model_name, False

def apply_replacements(text):
    for replacement_file in replacement_files:
        try:
            with open(replacement_file, "r", encoding="utf-8") as handle:
                for raw_line in handle:
                    line = raw_line.strip()
                    if not line or line.startswith("#") or "\t" not in line:
                        continue
                    source, target = line.split("\t", 1)
                    if source:
                        text = text.replace(source, target)
        except FileNotFoundError:
            continue
    if len(re.findall(r'(?<![A-Za-z])Z(?=\d)', text)) >= 2:
        text = re.sub(r'(?<![A-Za-z])Z(?=\d)', '', text)
    tokens = re.findall(r'[A-Za-z]+(?:[-_][A-Za-z0-9]+)*\d*|\d+|[\u4e00-\u9fff]+|[^\w\s]', text)
    if tokens:
        compact = [token.upper() for token in tokens if re.search(r'[A-Za-z0-9\u4e00-\u9fff]', token)]
        for size in range(1, 4):
            if len(compact) >= size * 6:
                chunks = [tuple(compact[i:i + size]) for i in range(0, min(len(compact), size * 8), size)]
                if len(chunks) >= 6 and len(set(chunks[:6])) <= 2:
                    return ''
    text = re.sub(r'\b([A-Z]{2,5})(?:[- ]?\d)?\b(?:[,，、\s]+\b\1(?:[- ]?\d)?\b){4,}', '', text).strip(' ,，、')
    return text

