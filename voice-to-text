#!/usr/bin/env bash
set -euo pipefail

APP_NAME="voice-to-text"
LANGUAGE="${VOICE_TO_TEXT_LANGUAGE:-auto}"
MODEL="${VOICE_TO_TEXT_MODEL:-small}"
BEAM_SIZE="${VOICE_TO_TEXT_BEAM_SIZE:-5}"
INITIAL_PROMPT="${VOICE_TO_TEXT_INITIAL_PROMPT:-以下是普通话和 English 混合的语音输入，请保留英文单词、技术名词、产品名和代码术语，中文使用简体字。}"
TMP_DIR="${XDG_RUNTIME_DIR:-/tmp}/voice-to-text"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/voice-to-text"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/voice-to-text"
VENV_DIR="$DATA_DIR/venv"
AUDIO_FORMAT="${VOICE_TO_TEXT_AUDIO_FORMAT:-pulse}"
AUDIO_SOURCE="${VOICE_TO_TEXT_AUDIO_SOURCE:-default}"
TERMS_LIMIT="${VOICE_TO_TEXT_TERMS_LIMIT:-120}"
TERMS_FILE="${VOICE_TO_TEXT_TERMS_FILE:-$CONFIG_DIR/terms.txt}"
REPLACEMENTS_FILE="${VOICE_TO_TEXT_REPLACEMENTS_FILE:-$CONFIG_DIR/replacements.tsv}"
BUILTIN_TERMS_FILE="$DATA_DIR/computer-terms.txt"
BUILTIN_REPLACEMENTS_FILE="$DATA_DIR/replacements.tsv"
HISTORY_FILE="${VOICE_TO_TEXT_HISTORY_FILE:-$DATA_DIR/history.tsv}"
HISTORY_LIMIT="${VOICE_TO_TEXT_HISTORY_LIMIT:-20}"
LOCK_DIR="$TMP_DIR/lock"
ffmpeg_pid=""

mkdir -p "$TMP_DIR"

cleanup() {
  if [ -n "$ffmpeg_pid" ] && kill -0 "$ffmpeg_pid" >/dev/null 2>&1; then
    kill -INT "$ffmpeg_pid" >/dev/null 2>&1 || true
    wait "$ffmpeg_pid" >/dev/null 2>&1 || true
  fi
  if [ -d "$LOCK_DIR" ]; then
    rm -f "$LOCK_DIR/pid" >/dev/null 2>&1 || true
    rmdir "$LOCK_DIR" >/dev/null 2>&1 || true
  fi
}

trap cleanup EXIT
trap 'cleanup; exit 130' INT TERM

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "$APP_NAME" "$1" >/dev/null 2>&1 || true
  fi
}

has_graphical_session() {
  [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]
}

die() {
  notify "$1"
  if command -v zenity >/dev/null 2>&1 && has_graphical_session; then
    zenity --error --title="$APP_NAME" --text="$1" >/dev/null 2>&1 || true
  else
    printf '%s\n' "$1" >&2
  fi
  exit 1
}

validate_config() {
  case "$BEAM_SIZE" in
    ''|*[!0-9]*) die "VOICE_TO_TEXT_BEAM_SIZE must be a positive integer." ;;
  esac
  [ "$BEAM_SIZE" -gt 0 ] || die "VOICE_TO_TEXT_BEAM_SIZE must be greater than 0."

  case "$TERMS_LIMIT" in
    ''|*[!0-9]*) die "VOICE_TO_TEXT_TERMS_LIMIT must be a non-negative integer." ;;
  esac

  case "$HISTORY_LIMIT" in
    ''|*[!0-9]*) die "VOICE_TO_TEXT_HISTORY_LIMIT must be a non-negative integer." ;;
  esac
}

build_initial_prompt() {
  local count=0
  local terms=""
  local file line

  for file in "$BUILTIN_TERMS_FILE" "$TERMS_FILE"; do
    [ -f "$file" ] || continue
    while IFS= read -r line || [ -n "$line" ]; do
      line="${line%%#*}"
      line="${line#"${line%%[![:space:]]*}"}"
      line="${line%"${line##*[![:space:]]}"}"
      [ -n "$line" ] || continue
      [ "$count" -lt "$TERMS_LIMIT" ] || break
      if [ -z "$terms" ]; then
        terms="$line"
      else
        terms="$terms、$line"
      fi
      count=$((count + 1))
    done < "$file"
    [ "$count" -lt "$TERMS_LIMIT" ] || break
  done

  if [ -n "$terms" ]; then
    printf '%s 常见计算机专有名词包括：%s。' "$INITIAL_PROMPT" "$terms"
  else
    printf '%s' "$INITIAL_PROMPT"
  fi
}

ensure_single_instance() {
  if ! mkdir "$LOCK_DIR" >/dev/null 2>&1; then
    if [ -f "$LOCK_DIR/pid" ]; then
      old_pid="$(sed -n '1p' "$LOCK_DIR/pid" 2>/dev/null || true)"
      if [ -n "$old_pid" ] && ! kill -0 "$old_pid" >/dev/null 2>&1; then
        rm -rf "$LOCK_DIR"
        mkdir "$LOCK_DIR" >/dev/null 2>&1 || die "Could not acquire voice-to-text lock."
      else
        die "voice-to-text is already running. Stop the current recording first."
      fi
    else
      die "voice-to-text is already running or a stale lock exists: $LOCK_DIR"
    fi
  fi
  printf '%s\n' "$$" > "$LOCK_DIR/pid"
}

ensure_recorder_backend() {
  if [ "$AUDIO_FORMAT" = "pulse" ]; then
    if ! command -v pactl >/dev/null 2>&1 && ! command -v wpctl >/dev/null 2>&1; then
      die "PulseAudio/PipeWire tools were not found. ffmpeg may not be able to record from the default microphone."
    fi
  fi
}

has_clipboard_backend() {
  if command -v wl-copy >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
    return 0
  fi
  if command -v xclip >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
    return 0
  fi
  if command -v xsel >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
    return 0
  fi
  return 1
}

setup_backend() {
  command -v uv >/dev/null 2>&1 || die "Missing uv. Install uv first, then run: voice-to-text --setup"
  mkdir -p "$DATA_DIR"
  if [ ! -x "$VENV_DIR/bin/python" ]; then
    uv venv "$VENV_DIR"
  fi
  uv pip install --python "$VENV_DIR/bin/python" faster-whisper zhconv
  notify "Speech recognition backend is installed."
}

check_environment() {
  validate_config
  command -v ffmpeg >/dev/null 2>&1 || die "Missing ffmpeg."
  ensure_recorder_backend
  has_clipboard_backend || die "Missing clipboard backend. Install wl-clipboard on Wayland, or xclip/xsel on X11."
  if [ -x "$VENV_DIR/bin/python" ] && "$VENV_DIR/bin/python" -c 'import faster_whisper, zhconv' >/dev/null 2>&1; then
    printf 'ASR backend: %s\n' "$VENV_DIR/bin/python"
  elif python3 -c 'import faster_whisper' >/dev/null 2>&1; then
    printf 'ASR backend: system python faster-whisper\n'
  elif command -v whisper >/dev/null 2>&1; then
    printf 'ASR backend: whisper CLI\n'
  else
    die "No speech recognition backend found. Run: voice-to-text --setup"
  fi
  printf 'Recorder: ffmpeg -f %s -i %s\n' "$AUDIO_FORMAT" "$AUDIO_SOURCE"
  printf 'Clipboard: available\n'
  printf 'Model: %s\n' "$MODEL"
  printf 'Language: %s\n' "$LANGUAGE"
  printf 'Beam size: %s\n' "$BEAM_SIZE"
  printf 'Terms limit: %s\n' "$TERMS_LIMIT"
  printf 'History limit: %s\n' "$HISTORY_LIMIT"
  [ -f "$BUILTIN_TERMS_FILE" ] && printf 'Built-in terms: %s\n' "$BUILTIN_TERMS_FILE"
  [ -f "$TERMS_FILE" ] && printf 'User terms: %s\n' "$TERMS_FILE"
  [ -f "$BUILTIN_REPLACEMENTS_FILE" ] && printf 'Built-in replacements: %s\n' "$BUILTIN_REPLACEMENTS_FILE"
  [ -f "$REPLACEMENTS_FILE" ] && printf 'User replacements: %s\n' "$REPLACEMENTS_FILE"
  printf 'History file: %s\n' "$HISTORY_FILE"
  printf 'voice-to-text check passed.\n'
}

init_config() {
  mkdir -p "$CONFIG_DIR"
  if [ ! -f "$TERMS_FILE" ]; then
    cat > "$TERMS_FILE" <<'EOF'
# Personal high-frequency terms, one per line.
# Keep this list focused: project names, product names, commands, libraries, and words you say often.
墨刃工坊
语贴
OpenCode
MiMoCode
EOF
  fi
  if [ ! -f "$REPLACEMENTS_FILE" ]; then
    cat > "$REPLACEMENTS_FILE" <<'EOF'
# Literal post-transcription replacements. Format: wrong<TAB>right
open code	OpenCode
git hub	GitHub
read me	README
EOF
  fi
  printf 'Config directory: %s\n' "$CONFIG_DIR"
  printf 'Terms file: %s\n' "$TERMS_FILE"
  printf 'Replacements file: %s\n' "$REPLACEMENTS_FILE"
}

doctor_check() {
  local label="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    printf 'ok   %s\n' "$label"
    return 0
  fi
  printf 'fail %s\n' "$label"
  return 1
}

doctor() {
  local failed=0

  printf 'voice-to-text doctor\n'
  printf 'Data dir: %s\n' "$DATA_DIR"
  printf 'Config dir: %s\n' "$CONFIG_DIR"
  printf 'Runtime dir: %s\n' "$TMP_DIR"

  doctor_check "ffmpeg" command -v ffmpeg || failed=1
  if [ "$AUDIO_FORMAT" = "pulse" ]; then
    if command -v pactl >/dev/null 2>&1 || command -v wpctl >/dev/null 2>&1; then
      printf 'ok   PulseAudio/PipeWire tools\n'
    else
      printf 'warn PulseAudio/PipeWire tools not found\n'
    fi
  fi
  if has_clipboard_backend; then
    printf 'ok   clipboard backend\n'
  else
    printf 'fail clipboard backend\n'
    failed=1
  fi
  if [ -x "$VENV_DIR/bin/python" ] && "$VENV_DIR/bin/python" -c 'import faster_whisper, zhconv' >/dev/null 2>&1; then
    printf 'ok   ASR venv: %s\n' "$VENV_DIR/bin/python"
  elif python3 -c 'import faster_whisper' >/dev/null 2>&1; then
    printf 'ok   system python faster-whisper\n'
  elif command -v whisper >/dev/null 2>&1; then
    printf 'ok   whisper CLI\n'
  else
    printf 'fail ASR backend\n'
    failed=1
  fi
  [ -f "$BUILTIN_TERMS_FILE" ] && printf 'ok   built-in terms\n' || printf 'warn built-in terms missing\n'
  [ -f "$BUILTIN_REPLACEMENTS_FILE" ] && printf 'ok   built-in replacements\n' || printf 'warn built-in replacements missing\n'
  [ -f "$TERMS_FILE" ] && printf 'ok   user terms\n' || printf 'info user terms not initialized\n'
  [ -f "$REPLACEMENTS_FILE" ] && printf 'ok   user replacements\n' || printf 'info user replacements not initialized\n'

  case "$BEAM_SIZE" in
    ''|*[!0-9]*|0) printf 'fail VOICE_TO_TEXT_BEAM_SIZE\n'; failed=1 ;;
    *) printf 'ok   VOICE_TO_TEXT_BEAM_SIZE=%s\n' "$BEAM_SIZE" ;;
  esac
  case "$TERMS_LIMIT" in
    ''|*[!0-9]*) printf 'fail VOICE_TO_TEXT_TERMS_LIMIT\n'; failed=1 ;;
    *) printf 'ok   VOICE_TO_TEXT_TERMS_LIMIT=%s\n' "$TERMS_LIMIT" ;;
  esac
  case "$HISTORY_LIMIT" in
    ''|*[!0-9]*) printf 'fail VOICE_TO_TEXT_HISTORY_LIMIT\n'; failed=1 ;;
    *) printf 'ok   VOICE_TO_TEXT_HISTORY_LIMIT=%s\n' "$HISTORY_LIMIT" ;;
  esac

  [ "$failed" -eq 0 ] || return 1
}

append_history() {
  local text="$1"
  local tmp_file clean_text

  [ "$HISTORY_LIMIT" -gt 0 ] || return 0
  mkdir -p "$(dirname "$HISTORY_FILE")"
  clean_text="$(printf '%s' "$text" | tr '\t\n' '  ')"
  printf '%s\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S%z)" "$clean_text" >> "$HISTORY_FILE"
  tmp_file="$HISTORY_FILE.tmp.$$"
  tail -n "$HISTORY_LIMIT" "$HISTORY_FILE" > "$tmp_file" && mv "$tmp_file" "$HISTORY_FILE"
  rm -f "$tmp_file" >/dev/null 2>&1 || true
}

show_history() {
  if [ ! -s "$HISTORY_FILE" ]; then
    printf 'No history yet.\n'
    return 0
  fi
  awk -F '\t' '{ printf "%d. [%s] %s\n", NR, $1, $2 }' "$HISTORY_FILE"
}

last_history_text() {
  local line=""
  [ -s "$HISTORY_FILE" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do :; done < "$HISTORY_FILE"
  [ -n "$line" ] || return 1
  printf '%s' "${line#*$'\t'}"
}

usage() {
  cat <<'EOF'
Usage: voice-to-text [command]

Commands:
  --setup        Install or update the local ASR backend
  --check        Check required runtime dependencies
  --doctor       Print a fuller diagnostic report
  --init-config  Create personal terms and correction files
  --history      Show recent transcripts
  --copy-last    Copy the latest transcript to the clipboard
  --help         Show this help

Run without a command to record, transcribe, and copy text.
EOF
}

copy_text() {
  local text="$1"
  if command -v wl-copy >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
    wl-copy --trim-newline "$text" >/dev/null 2>&1 &
  elif command -v xclip >/dev/null 2>&1; then
    printf '%s' "$text" | xclip -selection clipboard >/dev/null 2>&1 &
  elif command -v xsel >/dev/null 2>&1; then
    printf '%s' "$text" | xsel --clipboard --input >/dev/null 2>&1 &
  else
    return 1
  fi
}

case "${1:-}" in
  --setup)
    setup_backend
    exit 0
    ;;
  --check)
    check_environment
    exit 0
    ;;
  --doctor)
    doctor
    exit $?
    ;;
  --init-config)
    init_config
    exit 0
    ;;
  --history)
    show_history
    exit 0
    ;;
  --copy-last)
    has_clipboard_backend || die "Missing clipboard backend. Install wl-clipboard on Wayland, or xclip/xsel on X11."
    text="$(last_history_text)" || die "No history yet."
    copy_text "$text" || die "Clipboard copy failed."
    printf '%s\n' "$text"
    exit 0
    ;;
  --help|-h)
    usage
    exit 0
    ;;
  --*)
    usage >&2
    exit 2
    ;;
esac

transcribe_with_python_faster_whisper() {
  local audio_file="$1"
  local prompt="$2"
  python3 - "$audio_file" "$MODEL" "$LANGUAGE" "$BEAM_SIZE" "$prompt" "$BUILTIN_REPLACEMENTS_FILE" "$REPLACEMENTS_FILE" <<'PY'
import sys
from faster_whisper import WhisperModel

audio_file, model_name, language, beam_size, initial_prompt = sys.argv[1:6]
replacement_files = sys.argv[6:]

def apply_replacements(text):
    for replacement_file in replacement_files:
        try:
            with open(replacement_file, "r", encoding="utf-8") as handle:
                for raw_line in handle:
                    line = raw_line.strip()
                    if not line or line.startswith("#") or "\t" not in line:
                        continue
                    source, target = line.split("\t", 1)
                    if source:
                        text = text.replace(source, target)
        except FileNotFoundError:
            continue
    return text

model = WhisperModel(model_name, device="cpu", compute_type="int8")
kwargs = {
    "vad_filter": True,
    "beam_size": int(beam_size),
    "condition_on_previous_text": False,
    "initial_prompt": initial_prompt or None,
}
if language != "auto":
    kwargs["language"] = language
segments, _ = model.transcribe(audio_file, **kwargs)
text = "".join(segment.text for segment in segments).strip()
try:
    from zhconv import convert
    text = convert(text, "zh-cn")
except Exception:
    pass
text = apply_replacements(text)
print(text)
PY
}

transcribe() {
  local audio_file="$1"
  local prompt="$2"

  if [ -x "$VENV_DIR/bin/python" ] && "$VENV_DIR/bin/python" -c 'import faster_whisper' >/dev/null 2>&1; then
    "$VENV_DIR/bin/python" - "$audio_file" "$MODEL" "$LANGUAGE" "$BEAM_SIZE" "$prompt" "$BUILTIN_REPLACEMENTS_FILE" "$REPLACEMENTS_FILE" <<'PY'
import sys
from faster_whisper import WhisperModel

audio_file, model_name, language, beam_size, initial_prompt = sys.argv[1:6]
replacement_files = sys.argv[6:]

def apply_replacements(text):
    for replacement_file in replacement_files:
        try:
            with open(replacement_file, "r", encoding="utf-8") as handle:
                for raw_line in handle:
                    line = raw_line.strip()
                    if not line or line.startswith("#") or "\t" not in line:
                        continue
                    source, target = line.split("\t", 1)
                    if source:
                        text = text.replace(source, target)
        except FileNotFoundError:
            continue
    return text

model = WhisperModel(model_name, device="cpu", compute_type="int8")
kwargs = {
    "vad_filter": True,
    "beam_size": int(beam_size),
    "condition_on_previous_text": False,
    "initial_prompt": initial_prompt or None,
}
if language != "auto":
    kwargs["language"] = language
segments, _ = model.transcribe(audio_file, **kwargs)
text = "".join(segment.text for segment in segments).strip()
try:
    from zhconv import convert
    text = convert(text, "zh-cn")
except Exception:
    pass
text = apply_replacements(text)
print(text)
PY
    return
  fi

  if python3 -c 'import faster_whisper' >/dev/null 2>&1; then
    transcribe_with_python_faster_whisper "$audio_file" "$prompt"
    return
  fi

  if command -v whisper >/dev/null 2>&1; then
    local out_dir="$TMP_DIR/whisper-output-$$"
    mkdir -p "$out_dir"
    if [ "$LANGUAGE" = "auto" ]; then
      whisper "$audio_file" --model "$MODEL" --initial_prompt "$prompt" --output_format txt --output_dir "$out_dir" >/dev/null
    else
      whisper "$audio_file" --model "$MODEL" --language "$LANGUAGE" --initial_prompt "$prompt" --output_format txt --output_dir "$out_dir" >/dev/null
    fi
    sed -n '1,$p' "$out_dir/$(basename "${audio_file%.*}").txt"
    return
  fi

  die "No speech recognition backend found. Run: voice-to-text --setup"
}

command -v ffmpeg >/dev/null 2>&1 || die "Missing ffmpeg."
validate_config
ensure_single_instance
ensure_recorder_backend
has_clipboard_backend || die "Missing clipboard backend. Install wl-clipboard on Wayland, or xclip/xsel on X11."

timestamp="$(date +%Y%m%d-%H%M%S)"
audio_file="$TMP_DIR/recording-$timestamp.wav"
text_file="$TMP_DIR/transcript-$timestamp.txt"
error_file="$TMP_DIR/error-$timestamp.log"
record_error_file="$TMP_DIR/recording-error-$timestamp.log"
prompt="$(build_initial_prompt)"

notify "Recording started. Click the stop dialog when finished."

ffmpeg -hide_banner -loglevel error -y -f "$AUDIO_FORMAT" -i "$AUDIO_SOURCE" -ac 1 -ar 16000 "$audio_file" 2>"$record_error_file" &
ffmpeg_pid=$!

sleep 0.3
if ! kill -0 "$ffmpeg_pid" >/dev/null 2>&1; then
  wait "$ffmpeg_pid" >/dev/null 2>&1 || true
  error_text="$(sed -n '1,20p' "$record_error_file")"
  die "Recording failed to start: ${error_text:-unknown error}\n\nLog: $record_error_file"
fi

if command -v zenity >/dev/null 2>&1 && has_graphical_session; then
  zenity --info --title="$APP_NAME" --text="Recording...\n\nClick Stop when finished." --ok-label="Stop recording" >/dev/null 2>&1 || true
else
  printf 'Recording. Press Enter to stop...\n' >&2
  read -r _ || true
fi

if kill -0 "$ffmpeg_pid" >/dev/null 2>&1; then
  kill -INT "$ffmpeg_pid" >/dev/null 2>&1 || true
  wait "$ffmpeg_pid" >/dev/null 2>&1 || true
fi
ffmpeg_pid=""

if [ ! -s "$audio_file" ]; then
  error_text="$(sed -n '1,20p' "$record_error_file")"
  die "Recording failed. No valid audio was created. ${error_text:-}\n\nLog: $record_error_file"
fi

notify "Transcribing..."
if ! text="$(transcribe "$audio_file" "$prompt" 2>"$error_file" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"; then
  error_text="$(sed -n '1,20p' "$error_file")"
  die "Transcription failed: ${error_text:-unknown error}\n\nLog: $error_file"
fi
[ -n "$text" ] || die "No speech was recognized."

printf '%s\n' "$text" > "$text_file"
append_history "$text"
copy_text "$text" || die "Text recognized, but clipboard copy failed. Text file: $text_file"

notify "Copied to clipboard. Paste with Ctrl+V."

if command -v zenity >/dev/null 2>&1 && has_graphical_session; then
  zenity --info --title="$APP_NAME" --text="Copied to clipboard:\n\n$text" --ok-label="Close" >/dev/null 2>&1 || true
else
  printf '%s\n' "$text"
fi
