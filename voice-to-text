#!/usr/bin/env bash
set -euo pipefail

APP_NAME="语贴"
LANGUAGE="${VOICE_TO_TEXT_LANGUAGE:-auto}"
BACKEND="${VOICE_TO_TEXT_BACKEND:-auto}"
MODEL="${VOICE_TO_TEXT_MODEL:-medium}"
SV_MODEL="${VOICE_TO_TEXT_SENSEVOICE_MODEL:-iic/SenseVoiceSmall}"
SV_THREADS="${VOICE_TO_TEXT_SENSEVOICE_THREADS:-4}"
SV_MAX_SEGMENT="${VOICE_TO_TEXT_SENSEVOICE_MAX_SEGMENT:-25}"
BEAM_SIZE="${VOICE_TO_TEXT_BEAM_SIZE:-5}"
INITIAL_PROMPT="${VOICE_TO_TEXT_INITIAL_PROMPT:-以下是一段语音转文字的结果，内容包含中文简体字、English words、产品名和阿拉伯数字。}"
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
  TMP_DIR="$XDG_RUNTIME_DIR/voice-to-text"
else
  TMP_DIR="/tmp/voice-to-text-${UID}"
fi
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/voice-to-text"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/voice-to-text"
VENV_DIR="$DATA_DIR/venv"
SV_VENV_DIR="$DATA_DIR/venv-sensevoice"
AUDIO_FORMAT="${VOICE_TO_TEXT_AUDIO_FORMAT:-pulse}"
AUDIO_SOURCE="${VOICE_TO_TEXT_AUDIO_SOURCE:-default}"
# 录音最长时长（秒）。运行目录在 tmpfs（内存）上，16 kHz 单声道 ≈ 115 MB/小时，
# 万一录音源不限速（例如把 -f lavfi 指到文件）或热键被遗忘，也不至于把内存写满。
MAX_SECONDS="${VOICE_TO_TEXT_MAX_SECONDS:-3600}"
UI_MODE="${VOICE_TO_TEXT_UI:-auto}"
TERMS_LIMIT="${VOICE_TO_TEXT_TERMS_LIMIT:-40}"
TERMS_FILE="${VOICE_TO_TEXT_TERMS_FILE:-$CONFIG_DIR/terms.txt}"
REPLACEMENTS_FILE="${VOICE_TO_TEXT_REPLACEMENTS_FILE:-$CONFIG_DIR/replacements.tsv}"
BUILTIN_TERMS_FILE="$DATA_DIR/computer-terms.txt"
BUILTIN_REPLACEMENTS_FILE="$DATA_DIR/replacements.tsv"
HISTORY_FILE="${VOICE_TO_TEXT_HISTORY_FILE:-$DATA_DIR/history.tsv}"
HISTORY_LIMIT="${VOICE_TO_TEXT_HISTORY_LIMIT:-20}"
LOCK_DIR="$TMP_DIR/lock"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ffmpeg_pid=""
owns_lock=0
UI_BACKEND=""

umask 077
mkdir -p "$TMP_DIR"

process_is_running() {
  local pid="$1"
  local state

  kill -0 "$pid" >/dev/null 2>&1 || return 1
  state="$(ps -o stat= -p "$pid" 2>/dev/null || true)"
  state="${state#"${state%%[![:space:]]*}"}"
  [[ "$state" != Z* ]]
}

stop_process() {
  local pid="$1"
  local attempt=0

  [ -n "$pid" ] || return 0
  process_is_running "$pid" || return 0
  kill -CONT "$pid" >/dev/null 2>&1 || true
  kill -INT "$pid" >/dev/null 2>&1 || true
  while [ "$attempt" -lt 20 ]; do
    process_is_running "$pid" || return 0
    sleep 0.1
    attempt=$((attempt + 1))
  done
  kill -TERM "$pid" >/dev/null 2>&1 || true
  attempt=0
  while [ "$attempt" -lt 10 ]; do
    process_is_running "$pid" || return 0
    sleep 0.1
    attempt=$((attempt + 1))
  done
  kill -KILL "$pid" >/dev/null 2>&1 || true
}

cleanup() {
  if [ -n "$ffmpeg_pid" ] && kill -0 "$ffmpeg_pid" >/dev/null 2>&1; then
    stop_process "$ffmpeg_pid"
    wait "$ffmpeg_pid" >/dev/null 2>&1 || true
  fi
  if [ "$owns_lock" -eq 1 ] && [ -d "$LOCK_DIR" ] && [ "$(sed -n '1p' "$LOCK_DIR/pid" 2>/dev/null || true)" = "$$" ]; then
    rm -f "$LOCK_DIR/pid" >/dev/null 2>&1 || true
    rmdir "$LOCK_DIR" >/dev/null 2>&1 || true
  fi
}

trap cleanup EXIT
trap 'cleanup; exit 130' INT TERM

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "$APP_NAME" "$1" >/dev/null 2>&1 || true
  fi
}

format_duration() {
  local seconds="$1"
  printf '%02d:%02d' "$((seconds / 60))" "$((seconds % 60))"
}

# 静音录音时后端可能只吐标点（例如 SenseVoice 给出 "."），不算识别成功。

has_speech_content() {
  python3 - "$1" <<'PY'
import re
import sys

text = sys.argv[1] if len(sys.argv) > 1 else ""
# 去掉空白、标点和 SenseVoice 事件标记（<|...|>）后仍有字母/数字/汉字才算有内容
stripped = re.sub(r"[\s\W_]+", "", re.sub(r"<\|[^|]*\|>", "", text), flags=re.UNICODE)
sys.exit(0 if stripped else 1)
PY
}

has_graphical_session() {
  [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]
}

die() {
  local message="$1"

  printf '%s: %s\n' "$APP_NAME" "$message" >&2
  notify "$message"

  # 终端里运行时错误信息已经打印出来了，就不再弹窗打断。
  if [ -t 2 ]; then
    exit 1
  fi

  local ui_helper backend
  backend="$(resolve_ui_backend)"
  if [ "$backend" = gtk ] && ui_helper="$(ui_helper_path)"; then
    python3 "$ui_helper" error "$message" >/dev/null 2>&1 || true
    exit 1
  fi

  if { [ "$backend" = gtk ] || [ "$backend" = zenity ]; } && command -v zenity >/dev/null 2>&1 && has_graphical_session; then
    zenity --error --title="$APP_NAME" --text="$message" >/dev/null 2>&1 || true
  fi
  exit 1
}

validate_config() {
  case "$BEAM_SIZE" in
    ''|*[!0-9]*) die "VOICE_TO_TEXT_BEAM_SIZE 必须是正整数。" ;;
  esac
  [ "$BEAM_SIZE" -gt 0 ] || die "VOICE_TO_TEXT_BEAM_SIZE 必须大于 0。"

  case "$UI_MODE" in
    auto|gtk|zenity|none) ;;
    *) die "VOICE_TO_TEXT_UI 只能是 auto、gtk、zenity 或 none。" ;;
  esac

  case "$MAX_SECONDS" in
    ''|*[!0-9]*|0) die "VOICE_TO_TEXT_MAX_SECONDS 必须是正整数。" ;;
  esac

  case "$TERMS_LIMIT" in
    ''|*[!0-9]*) die "VOICE_TO_TEXT_TERMS_LIMIT 必须是非负整数。" ;;
  esac

  case "$HISTORY_LIMIT" in
    ''|*[!0-9]*) die "VOICE_TO_TEXT_HISTORY_LIMIT 必须是非负整数。" ;;
  esac

  case "$SV_THREADS" in
    ''|*[!0-9]*|0) die "VOICE_TO_TEXT_SENSEVOICE_THREADS 必须是正整数。" ;;
  esac

  case "$SV_MAX_SEGMENT" in
    ''|*[!0-9]*|0) die "VOICE_TO_TEXT_SENSEVOICE_MAX_SEGMENT 必须是正整数。" ;;
  esac

  case "$BACKEND" in
    auto|sensevoice|whisper) ;;
    *) die "VOICE_TO_TEXT_BACKEND 只能是 auto、sensevoice 或 whisper。" ;;
  esac
}

build_hotwords() {
  local count=0
  local terms=""
  local file line

  for file in "$TERMS_FILE" "$BUILTIN_TERMS_FILE"; do
    [ -f "$file" ] || continue
    while IFS= read -r line || [ -n "$line" ]; do
      line="${line%%#*}"
      line="${line#"${line%%[![:space:]]*}"}"
      line="${line%"${line##*[![:space:]]}"}"
      [ -n "$line" ] || continue

      # Very short all-caps protocol/encoding tokens are useful terms, but bad
      # hotwords: they can dominate uncertain speech and cause repeated output.
      if [[ "$line" =~ ^[A-Z0-9/.-]{2,5}$ ]]; then
        continue
      fi
      [ "$count" -lt "$TERMS_LIMIT" ] || break
      if [ -z "$terms" ]; then
        terms="$line"
      else
        terms="$terms, $line"
      fi
      count=$((count + 1))
    done < "$file"
    [ "$count" -lt "$TERMS_LIMIT" ] || break
  done

  printf '%s' "$terms"
}

ensure_single_instance() {
  if ! mkdir "$LOCK_DIR" >/dev/null 2>&1; then
    if [ -f "$LOCK_DIR/pid" ]; then
      old_pid="$(sed -n '1p' "$LOCK_DIR/pid" 2>/dev/null || true)"
      if [ -n "$old_pid" ] && ! kill -0 "$old_pid" >/dev/null 2>&1; then
        rm -rf "$LOCK_DIR"
        mkdir "$LOCK_DIR" >/dev/null 2>&1 || die "无法获取语贴的运行锁。"
      else
        die "语贴已经在录音了，请先停止当前录音。"
      fi
    else
      die "语贴已在运行，或上次异常退出留下了残留锁：$LOCK_DIR"
    fi
  fi
  printf '%s\n' "$$" > "$LOCK_DIR/pid"
  owns_lock=1
}

ensure_recorder_backend() {
  if [ "$AUDIO_FORMAT" = "pulse" ]; then
    if ! command -v pactl >/dev/null 2>&1 && ! command -v wpctl >/dev/null 2>&1; then
      die "没有找到 PulseAudio/PipeWire 工具，ffmpeg 可能无法从麦克风录音。"
    fi
  fi
}

has_clipboard_backend() {
  if command -v wl-copy >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
    return 0
  fi
  if command -v xclip >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
    return 0
  fi
  if command -v xsel >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
    return 0
  fi
  return 1
}

sensevoice_available() {
  [ -x "$SV_VENV_DIR/bin/python" ] || return 1
  "$SV_VENV_DIR/bin/python" -c 'import funasr_onnx, onnxruntime' >/dev/null 2>&1
}

whisper_available() {
  if [ -x "$VENV_DIR/bin/python" ] && "$VENV_DIR/bin/python" -c 'import faster_whisper' >/dev/null 2>&1; then
    return 0
  fi
  if python3 -c 'import faster_whisper' >/dev/null 2>&1; then
    return 0
  fi
  command -v whisper >/dev/null 2>&1
}

resolve_backend() {
  case "$BACKEND" in
    sensevoice)
      printf 'sensevoice'
      ;;
    whisper)
      printf 'whisper'
      ;;
    *)
      if sensevoice_available; then
        printf 'sensevoice'
      else
        printf 'whisper'
      fi
      ;;
  esac
}

# 优先使用本地已下载/已导出的模型目录，避免每次调用都联网向 ModelScope 查询。
sensevoice_model_dir() {
  local cache_root="${MODELSCOPE_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/modelscope}"
  local snapshot_name candidate

  if [ -d "$SV_MODEL" ]; then
    printf '%s' "$SV_MODEL"
    return 0
  fi

  snapshot_name="$(printf '%s' "$SV_MODEL" | sed 's|/|--|g')"
  for candidate in "$DATA_DIR/models/$snapshot_name" "$cache_root/models/$snapshot_name/snapshots/master"; do
    if [ -f "$candidate/model_quant.onnx" ] || [ -f "$candidate/model.onnx" ]; then
      printf '%s' "$candidate"
      return 0
    fi
  done

  printf '%s' "$SV_MODEL"
}

sensevoice_language() {
  case "$LANGUAGE" in
    auto|"") printf 'auto' ;;
    zh|zh-cn|zh-hans|zh_cn|zh-hant) printf 'zh' ;;
    en|yue|ja|ko) printf '%s' "$LANGUAGE" ;;
    *) printf 'auto' ;;
  esac
}

audio_duration() {
  local src_file="$1"
  local value
  value="$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$src_file" 2>/dev/null | head -n 1 || true)"
  case "$value" in
    ''|*[!0-9.]*) printf '0' ;;
    *) printf '%s' "${value%%.*}" ;;
  esac
}

# 「这段录音里到底有没有人说话」——送进后端之前先判一次。
# 只看平均音量会误伤：实测真人说话 7 条的 mean_volume 落在 -36.7 ~ -45.7 dB，
# 而房间里没人说话、只有一点响动的录音是 -50.8 dB，两者几乎贴在一起。
# 换用「-38 dB 以上、持续 0.25 秒以上的有效语音时长」做主判据（实测：
# 真人说话 1.54~12.6 秒，没人说话 0~0.49 秒），峰值与语音占比做兜底，
# 这样很短但清晰的一句（"好的"）依然能过。
speech_activity() {
  local src_file="$1"
  local activity max_volume speech_seconds mean_volume duration bytes
  activity="$(ffmpeg -hide_banner -nostdin -i "$src_file" -af "volumedetect,silencedetect=noise=-38dB:d=0.25" -f null - 2>&1 || true)"
  mean_volume="$(printf '%s\n' "$activity" | sed -n 's/.*mean_volume: \([-0-9.]*\) dB.*/\1/p' | sed -n '1p')"
  max_volume="$(printf '%s\n' "$activity" | sed -n 's/.*max_volume: \([-0-9.]*\) dB.*/\1/p' | sed -n '1p')"
  duration="$(audio_duration "$src_file")"
  # 录音被强杀（崩溃、磁盘写满、拔麦）时 WAV 头来不及收尾，RIFF 大小字段还是
  # 0xFFFFFFFF，ffprobe 会照文件大小编出个天文数字时长（实测会报「49601 秒」）。
  # 这种录音一律按字节数反推：录音固定是 16 kHz 单声道 s16le = 32000 字节/秒。
  case "$duration" in ''|*[!0-9.]*) duration=0 ;; esac
  if awk -v d="$duration" 'BEGIN { exit !(d <= 0 || d > 86400) }'; then
    bytes="$(stat -c%s "$src_file" 2>/dev/null || echo 0)"
    duration="$(awk -v b="$bytes" 'BEGIN { d = (b - 44) / 32000; if (d < 0) d = 0; printf "%.2f", d }')"
  fi
  speech_seconds="$(printf '%s\n' "$activity" | awk -v dur="$duration" '
    /silence_start:/ { line=$0; sub(/.*silence_start:[[:space:]]*/, "", line); sub(/[^0-9.-].*$/, "", line); starts[++n]=line+0 }
    /silence_end:/   { line=$0; sub(/.*silence_end:[[:space:]]*/,   "", line); sub(/[^0-9.-].*$/, "", line); ends[++m]=line+0 }
    END {
      silent = 0
      for (i = 1; i <= n; i++) {
        end = (i <= m) ? ends[i] : dur
        if (end > dur) end = dur
        if (end > starts[i]) silent += end - starts[i]
      }
      speech = dur - silent
      if (speech < 0) speech = 0
      printf "%.2f", speech
    }')"
  printf '%s %s %s %s\n' "${mean_volume:--99}" "${max_volume:--99}" "${speech_seconds:-0}" "$duration"
}

# 返回 0 = 判定为「没听到声音」（应拦下），1 = 有语音（继续转写）
looks_silent() {
  local src_file="$1" stats mean max speech duration
  stats="$(speech_activity "$src_file")"
  mean="$(printf '%s' "$stats" | cut -d' ' -f1)"
  max="$(printf '%s' "$stats" | cut -d' ' -f2)"
  speech="$(printf '%s' "$stats" | cut -d' ' -f3)"
  duration="$(printf '%s' "$stats" | cut -d' ' -f4)"
  SILENT_MEAN="$mean"
  SILENT_MAX="$max"
  SILENT_SPEECH="$speech"
  SILENT_DURATION="$duration"
  awk -v s="$speech" -v m="$max" -v d="$duration" 'BEGIN {
    # 判据只用「-38 dB 以上的有效语音时长」这一个绝对值，理由来自真机标定：
    #   真人一口气说话   有效语音 1.5–5.5 秒   → 必须放行
    #   一次很短的真话   0.47 / 0.49 秒        → 也要放行（旧的比例判据会把它们杀掉）
    #   安静房间底噪     0.07 秒（峰值 -34 dB）→ 拦住，那是键盘/风扇的瞬时声
    #   合成静音         0.00 秒（峰值 -91 dB）→ 拦住
    # 0.3 秒正好落在「点击/噪声毛刺」和「最短真实发音」之间。
    if (s + 0 >= 0.3) exit 1
    exit 0
  }'
}

# 运行目录在 tmpfs（内存）上，录音/转写/日志会随着使用累积，只留最近 N 份。
prune_runtime_files() {
  local keep="${VOICE_TO_TEXT_KEEP_FILES:-20}"
  case "$keep" in ''|*[!0-9]*) keep=20 ;; esac
  [ "$keep" -gt 0 ] || return 0
  local pattern
  for pattern in 'recording-*.wav' 'transcript-*.txt' 'error-*.log' 'recording-error-*.log' 'sensevoice-segments-*'; do
    find "$TMP_DIR" -maxdepth 1 -name "$pattern" -printf '%T@\t%p\n' 2>/dev/null |
      sort -rn |
      tail -n "+$((keep + 1))" |
      cut -f2- |
      while IFS= read -r stale; do
        [ -n "$stale" ] && rm -rf -- "$stale" 2>/dev/null
      done
  done
}

# SenseVoice 是单段模型，超过 SV_MAX_SEGMENT 的录音按静音点切分：
# 输出 "起 止" 行；"0 -1" 表示整段直接用原文件。
plan_audio_segments() {
  local src_file="$1"
  local duration silences
  duration="$(audio_duration "$src_file")"
  if [ "$duration" -le 0 ] || [ "$duration" -le "$SV_MAX_SEGMENT" ]; then
    printf '0 -1\n'
    return 0
  fi

  silences="$(ffmpeg -hide_banner -nostats -i "$src_file" -af silencedetect=noise=-35dB:d=0.3 -f null - 2>&1 |
    sed -n 's/.*silence_end: \([0-9.]*\).*/\1/p' || true)"

  printf '%s\n' "$silences" | awk -v max="$SV_MAX_SEGMENT" -v total="$duration" '
    /^[0-9.]+$/ { points[count++] = $1 + 0 }
    END {
      start = 0
      cursor = 0
      guard = 0
      while (start + max < total && guard++ < 500) {
        limit = start + max
        best = -1
        for (j = cursor; j < count; j++) {
          if (points[j] > limit) break
          if (points[j] > start + 1) best = points[j]
        }
        if (best < 0) best = limit
        printf "%.3f %.3f\n", start, best
        start = best
        while (cursor < count && points[cursor] <= best) cursor++
      }
      printf "%.3f %.3f\n", start, total
    }'
}

setup_backend() {
  command -v uv >/dev/null 2>&1 || die "缺少 uv，请先安装 uv，然后运行：voice-to-text --setup"
  mkdir -p "$DATA_DIR"
  setup_whisper_backend
  setup_sensevoice_backend
  notify "Speech recognition backend is installed."
}

setup_whisper_backend() {
  if [ ! -x "$VENV_DIR/bin/python" ]; then
    uv venv "$VENV_DIR"
  fi
  uv pip install --python "$VENV_DIR/bin/python" faster-whisper zhconv
}

setup_sensevoice_backend() {
  if [ ! -x "$SV_VENV_DIR/bin/python" ]; then
    # funasr-onnx 依赖 numpy<=1.26.4 与 kaldi-native-fbank，两者都没有 3.14 的轮子，
    # 因此 SenseVoice 单独用一个 3.12 虚拟环境，与 whisper 的 3.14 环境互不干扰。
    uv venv --python 3.12 "$SV_VENV_DIR"
  fi
  uv pip install --python "$SV_VENV_DIR/bin/python" funasr-onnx onnxruntime modelscope zhconv
  ensure_sensevoice_model
}

# 模型首次使用时要导出 ONNX：导出依赖 PyTorch，只在临时环境里做，成功后删掉，
# 这样日常环境不会为了 2GB 的 torch 长期占空间。
ensure_sensevoice_model() {
  local log_file="$TMP_DIR/sensevoice-setup.log"
  local export_venv="$DATA_DIR/venv-sensevoice-export"
  local model_dir
  model_dir="$(sensevoice_model_dir)"

  if sensevoice_model_probe "$SV_VENV_DIR" "$model_dir" >>"$log_file" 2>&1; then
    return 0
  fi

  if ! grep -q "please install funasr" "$log_file" 2>/dev/null; then
    die "SenseVoice 模型不可用。日志：$log_file"
  fi

  notify "SenseVoice 首次初始化：正在导出 ONNX 模型，需要额外下载 PyTorch（仅此一次）。"

  if [ ! -x "$export_venv/bin/python" ]; then
    uv venv --python 3.12 "$export_venv"
  fi
  uv pip install --python "$export_venv/bin/python" torch torchaudio --index-url https://download.pytorch.org/whl/cpu
  uv pip install --python "$export_venv/bin/python" funasr funasr-onnx onnxscript modelscope zhconv

  if ! sensevoice_model_probe "$export_venv" "$model_dir" >>"$log_file" 2>&1; then
    die "SenseVoice ONNX 导出失败。日志：$log_file"
  fi

  rm -rf "$export_venv"
  notify "SenseVoice 模型已就绪。"
}

# 用指定环境加载模型：能加载说明 ONNX 已经导出好，报缺 funasr 说明还需要导出。
sensevoice_model_probe() {
  local venv_dir="$1"
  local model_dir="$2"

  "$venv_dir/bin/python" -c '
import sys
from funasr_onnx import SenseVoiceSmall
SenseVoiceSmall(model_dir=sys.argv[1], quantize=True)
' "$model_dir"
}

check_environment() {
  validate_config
  command -v ffmpeg >/dev/null 2>&1 || die "缺少 ffmpeg，请先安装（Arch：sudo pacman -S ffmpeg）。"
  ensure_recorder_backend
  has_clipboard_backend || die "缺少剪贴板工具：Wayland 需要 wl-clipboard，X11 需要 xclip 或 xsel。"
  if sensevoice_available; then
    printf 'SenseVoice backend: %s\n' "$SV_VENV_DIR/bin/python"
  fi
  if [ -x "$VENV_DIR/bin/python" ] && "$VENV_DIR/bin/python" -c 'import faster_whisper, zhconv' >/dev/null 2>&1; then
    printf 'whisper backend: %s\n' "$VENV_DIR/bin/python"
  elif python3 -c 'import faster_whisper' >/dev/null 2>&1; then
    printf 'whisper backend: system python faster-whisper\n'
  elif command -v whisper >/dev/null 2>&1; then
    printf 'whisper backend: whisper CLI\n'
  fi
  if ! sensevoice_available && ! whisper_available; then
    die "没有可用的语音识别后端，请先运行：voice-to-text --setup"
  fi
  if [ "$BACKEND" = "sensevoice" ] && ! sensevoice_available; then
    die "VOICE_TO_TEXT_BACKEND=sensevoice，但 SenseVoice 后端尚未安装。请运行：voice-to-text --setup"
  fi
  if [ "$BACKEND" = "whisper" ] && ! whisper_available; then
    die "VOICE_TO_TEXT_BACKEND=whisper，但 whisper 后端尚未安装。请运行：voice-to-text --setup"
  fi
  printf 'Selected backend: %s\n' "$(resolve_backend)"
  if [ "$(resolve_backend)" = "sensevoice" ]; then
    printf 'SenseVoice model: %s\n' "$SV_MODEL"
    printf 'SenseVoice model dir: %s\n' "$(sensevoice_model_dir)"
