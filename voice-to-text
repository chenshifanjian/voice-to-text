#!/usr/bin/env bash
set -euo pipefail

APP_NAME="语贴"
LANGUAGE="${VOICE_TO_TEXT_LANGUAGE:-auto}"
MODEL="${VOICE_TO_TEXT_MODEL:-small}"
BEAM_SIZE="${VOICE_TO_TEXT_BEAM_SIZE:-5}"
INITIAL_PROMPT="${VOICE_TO_TEXT_INITIAL_PROMPT:-这是日常语音输入，可能包含中文、English words、产品名、命令和数字。请按实际发音转写，中文使用简体字，英文单词保留英文，普通数字识别为阿拉伯数字，不要在数字前添加字母。}"
TMP_DIR="${XDG_RUNTIME_DIR:-/tmp}/voice-to-text"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/voice-to-text"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/voice-to-text"
VENV_DIR="$DATA_DIR/venv"
AUDIO_FORMAT="${VOICE_TO_TEXT_AUDIO_FORMAT:-pulse}"
AUDIO_SOURCE="${VOICE_TO_TEXT_AUDIO_SOURCE:-default}"
TERMS_LIMIT="${VOICE_TO_TEXT_TERMS_LIMIT:-40}"
TERMS_FILE="${VOICE_TO_TEXT_TERMS_FILE:-$CONFIG_DIR/terms.txt}"
REPLACEMENTS_FILE="${VOICE_TO_TEXT_REPLACEMENTS_FILE:-$CONFIG_DIR/replacements.tsv}"
BUILTIN_TERMS_FILE="$DATA_DIR/computer-terms.txt"
BUILTIN_REPLACEMENTS_FILE="$DATA_DIR/replacements.tsv"
HISTORY_FILE="${VOICE_TO_TEXT_HISTORY_FILE:-$DATA_DIR/history.tsv}"
HISTORY_LIMIT="${VOICE_TO_TEXT_HISTORY_LIMIT:-20}"
LOCK_DIR="$TMP_DIR/lock"
ffmpeg_pid=""

mkdir -p "$TMP_DIR"

cleanup() {
  if [ -n "$ffmpeg_pid" ] && kill -0 "$ffmpeg_pid" >/dev/null 2>&1; then
    kill -CONT "$ffmpeg_pid" >/dev/null 2>&1 || true
    kill -INT "$ffmpeg_pid" >/dev/null 2>&1 || true
    wait "$ffmpeg_pid" >/dev/null 2>&1 || true
  fi
  if [ -d "$LOCK_DIR" ]; then
    rm -f "$LOCK_DIR/pid" >/dev/null 2>&1 || true
    rmdir "$LOCK_DIR" >/dev/null 2>&1 || true
  fi
}

trap cleanup EXIT
trap 'cleanup; exit 130' INT TERM

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "$APP_NAME" "$1" >/dev/null 2>&1 || true
  fi
}

format_duration() {
  local seconds="$1"
  printf '%02d:%02d' "$((seconds / 60))" "$((seconds % 60))"
}

has_graphical_session() {
  [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]
}

die() {
  notify "$1"
  if command -v zenity >/dev/null 2>&1 && has_graphical_session; then
    zenity --error --title="$APP_NAME" --text="$1" >/dev/null 2>&1 || true
  else
    printf '%s\n' "$1" >&2
  fi
  exit 1
}

validate_config() {
  case "$BEAM_SIZE" in
    ''|*[!0-9]*) die "VOICE_TO_TEXT_BEAM_SIZE must be a positive integer." ;;
  esac
  [ "$BEAM_SIZE" -gt 0 ] || die "VOICE_TO_TEXT_BEAM_SIZE must be greater than 0."

  case "$TERMS_LIMIT" in
    ''|*[!0-9]*) die "VOICE_TO_TEXT_TERMS_LIMIT must be a non-negative integer." ;;
  esac

  case "$HISTORY_LIMIT" in
    ''|*[!0-9]*) die "VOICE_TO_TEXT_HISTORY_LIMIT must be a non-negative integer." ;;
  esac
}

build_hotwords() {
  local count=0
  local terms=""
  local file line

  for file in "$BUILTIN_TERMS_FILE" "$TERMS_FILE"; do
    [ -f "$file" ] || continue
    while IFS= read -r line || [ -n "$line" ]; do
      line="${line%%#*}"
      line="${line#"${line%%[![:space:]]*}"}"
      line="${line%"${line##*[![:space:]]}"}"
      [ -n "$line" ] || continue
      [ "$count" -lt "$TERMS_LIMIT" ] || break
      if [ -z "$terms" ]; then
        terms="$line"
      else
        terms="$terms, $line"
      fi
      count=$((count + 1))
    done < "$file"
    [ "$count" -lt "$TERMS_LIMIT" ] || break
  done

  printf '%s' "$terms"
}

ensure_single_instance() {
  if ! mkdir "$LOCK_DIR" >/dev/null 2>&1; then
    if [ -f "$LOCK_DIR/pid" ]; then
      old_pid="$(sed -n '1p' "$LOCK_DIR/pid" 2>/dev/null || true)"
      if [ -n "$old_pid" ] && ! kill -0 "$old_pid" >/dev/null 2>&1; then
        rm -rf "$LOCK_DIR"
        mkdir "$LOCK_DIR" >/dev/null 2>&1 || die "Could not acquire voice-to-text lock."
      else
        die "voice-to-text is already running. Stop the current recording first."
      fi
    else
      die "voice-to-text is already running or a stale lock exists: $LOCK_DIR"
    fi
  fi
  printf '%s\n' "$$" > "$LOCK_DIR/pid"
}

ensure_recorder_backend() {
  if [ "$AUDIO_FORMAT" = "pulse" ]; then
    if ! command -v pactl >/dev/null 2>&1 && ! command -v wpctl >/dev/null 2>&1; then
      die "PulseAudio/PipeWire tools were not found. ffmpeg may not be able to record from the default microphone."
    fi
  fi
}

has_clipboard_backend() {
  if command -v wl-copy >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
    return 0
  fi
  if command -v xclip >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
    return 0
  fi
  if command -v xsel >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
    return 0
  fi
  return 1
}

setup_backend() {
  command -v uv >/dev/null 2>&1 || die "Missing uv. Install uv first, then run: voice-to-text --setup"
  mkdir -p "$DATA_DIR"
  if [ ! -x "$VENV_DIR/bin/python" ]; then
    uv venv "$VENV_DIR"
  fi
  uv pip install --python "$VENV_DIR/bin/python" faster-whisper zhconv
  notify "Speech recognition backend is installed."
}

check_environment() {
  validate_config
  command -v ffmpeg >/dev/null 2>&1 || die "Missing ffmpeg."
  ensure_recorder_backend
  has_clipboard_backend || die "Missing clipboard backend. Install wl-clipboard on Wayland, or xclip/xsel on X11."
  if [ -x "$VENV_DIR/bin/python" ] && "$VENV_DIR/bin/python" -c 'import faster_whisper, zhconv' >/dev/null 2>&1; then
    printf 'ASR backend: %s\n' "$VENV_DIR/bin/python"
  elif python3 -c 'import faster_whisper' >/dev/null 2>&1; then
    printf 'ASR backend: system python faster-whisper\n'
  elif command -v whisper >/dev/null 2>&1; then
    printf 'ASR backend: whisper CLI\n'
  else
    die "No speech recognition backend found. Run: voice-to-text --setup"
  fi
  printf 'Recorder: ffmpeg -f %s -i %s\n' "$AUDIO_FORMAT" "$AUDIO_SOURCE"
  printf 'Clipboard: available\n'
  printf 'Model: %s\n' "$MODEL"
  printf 'Language: %s\n' "$LANGUAGE"
  printf 'Beam size: %s\n' "$BEAM_SIZE"
  printf 'Terms limit: %s\n' "$TERMS_LIMIT"
  printf 'History limit: %s\n' "$HISTORY_LIMIT"
  [ -f "$BUILTIN_TERMS_FILE" ] && printf 'Built-in terms: %s\n' "$BUILTIN_TERMS_FILE"
  [ -f "$TERMS_FILE" ] && printf 'User terms: %s\n' "$TERMS_FILE"
  [ -f "$BUILTIN_REPLACEMENTS_FILE" ] && printf 'Built-in replacements: %s\n' "$BUILTIN_REPLACEMENTS_FILE"
  [ -f "$REPLACEMENTS_FILE" ] && printf 'User replacements: %s\n' "$REPLACEMENTS_FILE"
  printf 'History file: %s\n' "$HISTORY_FILE"
  printf 'voice-to-text check passed.\n'
}

init_config() {
  mkdir -p "$CONFIG_DIR"
  if [ ! -f "$TERMS_FILE" ]; then
    cat > "$TERMS_FILE" <<'EOF'
# Personal high-frequency terms, one per line.
# Keep this list focused: project names, product names, commands, libraries, and words you say often.
墨刃工坊
语贴
OpenCode
MiMoCode
EOF
  fi
  if [ ! -f "$REPLACEMENTS_FILE" ]; then
    cat > "$REPLACEMENTS_FILE" <<'EOF'
# Literal post-transcription replacements. Format: wrong<TAB>right
open code	OpenCode
git hub	GitHub
read me	README
EOF
  fi
  printf 'Config directory: %s\n' "$CONFIG_DIR"
  printf 'Terms file: %s\n' "$TERMS_FILE"
  printf 'Replacements file: %s\n' "$REPLACEMENTS_FILE"
}

doctor_check() {
  local label="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    printf 'ok   %s\n' "$label"
    return 0
  fi
  printf 'fail %s\n' "$label"
  return 1
}

doctor() {
  local failed=0

  printf 'voice-to-text doctor\n'
  printf 'Data dir: %s\n' "$DATA_DIR"
  printf 'Config dir: %s\n' "$CONFIG_DIR"
  printf 'Runtime dir: %s\n' "$TMP_DIR"

  doctor_check "ffmpeg" command -v ffmpeg || failed=1
  if [ "$AUDIO_FORMAT" = "pulse" ]; then
    if command -v pactl >/dev/null 2>&1 || command -v wpctl >/dev/null 2>&1; then
      printf 'ok   PulseAudio/PipeWire tools\n'
    else
      printf 'warn PulseAudio/PipeWire tools not found\n'
    fi
  fi
  if has_clipboard_backend; then
    printf 'ok   clipboard backend\n'
  else
    printf 'fail clipboard backend\n'
    failed=1
  fi
  if [ -x "$VENV_DIR/bin/python" ] && "$VENV_DIR/bin/python" -c 'import faster_whisper, zhconv' >/dev/null 2>&1; then
    printf 'ok   ASR venv: %s\n' "$VENV_DIR/bin/python"
  elif python3 -c 'import faster_whisper' >/dev/null 2>&1; then
    printf 'ok   system python faster-whisper\n'
  elif command -v whisper >/dev/null 2>&1; then
    printf 'ok   whisper CLI\n'
  else
    printf 'fail ASR backend\n'
    failed=1
  fi
  [ -f "$BUILTIN_TERMS_FILE" ] && printf 'ok   built-in terms\n' || printf 'warn built-in terms missing\n'
  [ -f "$BUILTIN_REPLACEMENTS_FILE" ] && printf 'ok   built-in replacements\n' || printf 'warn built-in replacements missing\n'
  [ -f "$TERMS_FILE" ] && printf 'ok   user terms\n' || printf 'info user terms not initialized\n'
  [ -f "$REPLACEMENTS_FILE" ] && printf 'ok   user replacements\n' || printf 'info user replacements not initialized\n'

  case "$BEAM_SIZE" in
    ''|*[!0-9]*|0) printf 'fail VOICE_TO_TEXT_BEAM_SIZE\n'; failed=1 ;;
    *) printf 'ok   VOICE_TO_TEXT_BEAM_SIZE=%s\n' "$BEAM_SIZE" ;;
  esac
  case "$TERMS_LIMIT" in
    ''|*[!0-9]*) printf 'fail VOICE_TO_TEXT_TERMS_LIMIT\n'; failed=1 ;;
    *) printf 'ok   VOICE_TO_TEXT_TERMS_LIMIT=%s\n' "$TERMS_LIMIT" ;;
  esac
  case "$HISTORY_LIMIT" in
    ''|*[!0-9]*) printf 'fail VOICE_TO_TEXT_HISTORY_LIMIT\n'; failed=1 ;;
    *) printf 'ok   VOICE_TO_TEXT_HISTORY_LIMIT=%s\n' "$HISTORY_LIMIT" ;;
  esac

  [ "$failed" -eq 0 ] || return 1
}

append_history() {
  local text="$1"
  local tmp_file clean_text

  [ "$HISTORY_LIMIT" -gt 0 ] || return 0
  mkdir -p "$(dirname "$HISTORY_FILE")"
  clean_text="$(printf '%s' "$text" | tr '\t\n' '  ')"
  printf '%s\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S%z)" "$clean_text" >> "$HISTORY_FILE"
  tmp_file="$HISTORY_FILE.tmp.$$"
  tail -n "$HISTORY_LIMIT" "$HISTORY_FILE" > "$tmp_file" && mv "$tmp_file" "$HISTORY_FILE"
  rm -f "$tmp_file" >/dev/null 2>&1 || true
}

show_history() {
  if [ ! -s "$HISTORY_FILE" ]; then
    printf 'No history yet.\n'
    return 0
  fi
  awk -F '\t' '{ printf "%d. [%s] %s\n", NR, $1, $2 }' "$HISTORY_FILE"
}

last_history_text() {
  local line=""
  [ -s "$HISTORY_FILE" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do :; done < "$HISTORY_FILE"
  [ -n "$line" ] || return 1
  printf '%s' "${line#*$'\t'}"
}

usage() {
  cat <<'EOF'
Usage: voice-to-text [command]

Commands:
  --setup        Install or update the local ASR backend
  --check        Check required runtime dependencies
  --doctor       Print a fuller diagnostic report
  --init-config  Create personal terms and correction files
  --history      Show recent transcripts
  --copy-last    Copy the latest transcript to the clipboard
  --help         Show this help

Run without a command to record, transcribe, and copy text.
EOF
}

copy_text() {
  local text="$1"
  if command -v wl-copy >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
    wl-copy --trim-newline "$text" >/dev/null 2>&1 &
  elif command -v xclip >/dev/null 2>&1; then
    printf '%s' "$text" | xclip -selection clipboard >/dev/null 2>&1 &
  elif command -v xsel >/dev/null 2>&1; then
    printf '%s' "$text" | xsel --clipboard --input >/dev/null 2>&1 &
  else
    return 1
  fi
}

show_recording_dialog() {
  local started_at elapsed duration wave_index wave

  if has_graphical_session && python3 -c 'import tkinter' >/dev/null 2>&1; then
    python3 - "$ffmpeg_pid" "$AUDIO_FORMAT" "$AUDIO_SOURCE" <<'PY'
import math
import os
import queue
import signal
import subprocess
import sys
import threading
import time
import tkinter as tk
import tkinter.font as tkfont

recorder_pid = int(sys.argv[1])
audio_format = sys.argv[2]
audio_source = sys.argv[3]

audio_queue = queue.Queue()
paused = False
stopping = False
monitor = None
pause_started = 0.0
paused_total = 0.0
started_at = time.monotonic()
spectrum_levels = [0.0] * 32
waveform_points = [0.0] * 96
last_spectrum_at = 0.0
phase = 0.0
bar_count = 32
waveform_count = 96
visualizer_mode = os.environ.get("VOICE_TO_TEXT_VISUALIZER", "waveform").lower()
if visualizer_mode not in {"waveform", "spectrum"}:
    visualizer_mode = "waveform"
theme_name = os.environ.get("VOICE_TO_TEXT_THEME", "dark").lower()
if theme_name not in {"light", "dark"}:
    theme_name = "light"
themes = {
    "light": {
        "bg": "#f6f8fb",
        "panel": "#ffffff",
        "text": "#111827",
        "muted": "#64748b",
        "canvas": "#ffffff",
        "border": "#d8dee9",
        "bar": "#16a34a",
        "quiet": "#d7dee8",
        "button_bg": "#f3f4f6",
        "button_fg": "#111827",
    },
    "dark": {
        "bg": "#111827",
        "panel": "#18212f",
        "text": "#f8fafc",
        "muted": "#94a3b8",
        "canvas": "#0f172a",
        "border": "#334155",
        "bar": "#22c55e",
        "quiet": "#334155",
        "button_bg": "#1f2937",
        "button_fg": "#f8fafc",
    },
}
theme = themes[theme_name]


def clamp(value, low, high):
    return max(low, min(high, value))


def pick_font_family(root):
    candidates = [
        "Noto Sans CJK SC",
        "WenQuanYi Micro Hei",
        "Source Han Sans SC",
        "Microsoft YaHei",
        "PingFang SC",
        "DejaVu Sans",
    ]
    families = set(tkfont.families(root))
    for candidate in candidates:
        if candidate in families:
            return candidate
    return "TkDefaultFont"


def monitor_audio():
    global monitor
    while not stopping:
        cmd = [
            "ffmpeg",
            "-hide_banner",
            "-nostats",
            "-loglevel",
            "error",
            "-f",
            audio_format,
            "-i",
            audio_source,
            "-ac",
            "1",
            "-ar",
            "16000",
            "-f",
            "s16le",
            "-",
        ]
        try:
            monitor = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
            )
        except Exception:
            time.sleep(0.5)
            continue

        assert monitor.stdout is not None
        sample_rate = 16000
        chunk_samples = 1024
        band_frequencies = []
        hann_window = [0.5 - 0.5 * math.cos(2.0 * math.pi * n / (chunk_samples - 1)) for n in range(chunk_samples)]
        min_freq = 90.0
        max_freq = 4200.0
        for band in range(bar_count):
            low = min_freq * ((max_freq / min_freq) ** (band / bar_count))
            high = min_freq * ((max_freq / min_freq) ** ((band + 1) / bar_count))
            band_frequencies.append(math.sqrt(low * high))
        band_coefficients = [2.0 * math.cos(2.0 * math.pi * frequency / sample_rate) for frequency in band_frequencies]

        while not stopping:
            raw = monitor.stdout.read(chunk_samples * 2)
            if len(raw) < chunk_samples * 2:
                break
            samples = [int.from_bytes(raw[i:i + 2], "little", signed=True) / 32768.0 for i in range(0, len(raw), 2)]
            waveform = []
            bucket_size = max(1, len(samples) // waveform_count)
            for point in range(waveform_count):
                start = point * bucket_size
                bucket = samples[start:start + bucket_size]
                if not bucket:
                    waveform.append(0.0)
                    continue
                peak = max(bucket, key=abs)
                waveform.append(peak)
            energies = [0.0] * bar_count
            if visualizer_mode == "spectrum":
                energies = []
                for coeff in band_coefficients:
                    prev = 0.0
                    prev2 = 0.0
                    for sample, window in zip(samples, hann_window):
                        value = sample * window + coeff * prev - prev2
                        prev2 = prev
                        prev = value
                    energy = math.sqrt(max(0.0, prev2 * prev2 + prev * prev - coeff * prev * prev2))
                    level = clamp((math.log10(energy + 1e-7) + 3.8) / 2.2, 0.0, 1.0)
                    if level < 0.035:
                        level = 0.0
                    energies.append(level)
            audio_queue.put((waveform, energies))
        if monitor.poll() is None:
            monitor.terminate()
        time.sleep(0.25)


def safe_signal(sig):
    try:
        os.kill(recorder_pid, sig)
    except ProcessLookupError:
        pass


def toggle_pause():
    global paused, pause_started, paused_total
    if paused:
        safe_signal(signal.SIGCONT)
        paused_total += time.monotonic() - pause_started
        paused = False
        pause_button.config(text="暂停录音")
        status_label.config(text="正在录音")
    else:
        safe_signal(signal.SIGSTOP)
        pause_started = time.monotonic()
        paused = True
        pause_button.config(text="继续录音")
        status_label.config(text="已暂停")


def apply_theme():
    root.configure(bg=theme["bg"])
    main.configure(bg=theme["panel"])
    header.configure(bg=theme["panel"])
    title_label.configure(bg=theme["panel"], fg=theme["text"])
    status_label.configure(bg=theme["panel"], fg=theme["muted"])
    buttons.configure(bg=theme["panel"])
    time_label.configure(bg=theme["panel"], fg=theme["text"])
    hint_label.configure(bg=theme["panel"], fg=theme["muted"])
    canvas.configure(bg=theme["canvas"], highlightbackground=theme["border"])
    for button in (pause_button, stop_button, theme_button):
        button.configure(
            bg=theme["button_bg"],
            fg=theme["button_fg"],
            activebackground=theme["button_bg"],
            activeforeground=theme["button_fg"],
        )


def toggle_theme():
    global theme_name, theme
    theme_name = "light" if theme_name == "dark" else "dark"
    theme = themes[theme_name]
    theme_button.config(text="☾" if theme_name == "dark" else "☀")
    apply_theme()


def stop_recording():
    global stopping, paused, paused_total
    if stopping:
        return
    stopping = True
    if paused:
        safe_signal(signal.SIGCONT)
        paused_total += time.monotonic() - pause_started
        paused = False
    if monitor is not None and monitor.poll() is None:
        monitor.terminate()
    root.destroy()


def format_duration(seconds):
    seconds = max(0, int(seconds))
    return f"{seconds // 60:02d}:{seconds % 60:02d}"


def update_ui():
    global waveform_points, spectrum_levels, last_spectrum_at, phase
    latest_waveform = None
    latest_spectrum = None
    while True:
        try:
            latest_waveform, latest_spectrum = audio_queue.get_nowait()
        except queue.Empty:
            break
    if latest_spectrum is not None and latest_waveform is not None and not paused:
        spectrum_levels = [max(old * 0.55, new) for old, new in zip(spectrum_levels, latest_spectrum)]
        waveform_points = [old * 0.35 + new * 0.65 for old, new in zip(waveform_points, latest_waveform)]
        last_spectrum_at = time.monotonic()
    else:
        spectrum_levels = [level * 0.76 for level in spectrum_levels]
        waveform_points = [point * 0.72 for point in waveform_points]
    if paused or time.monotonic() - last_spectrum_at > 0.35:
        spectrum_levels = [level * 0.58 for level in spectrum_levels]
        waveform_points = [point * 0.58 for point in waveform_points]

    active_paused = time.monotonic() - pause_started if paused else 0.0
    elapsed = time.monotonic() - started_at - paused_total - active_paused
    time_label.config(text=format_duration(elapsed))

    canvas.delete("all")
    width = int(canvas.winfo_width() or 390)
    height = int(canvas.winfo_height() or 74)
    center = height / 2
    peak = max(spectrum_levels) if spectrum_levels else 0.0
    wave_peak = max((abs(point) for point in waveform_points), default=0.0)
    peak = max(peak, wave_peak)
    phase += 0.22 if peak > 0.03 and not paused else 0.02

    canvas.create_line(0, center, width, center, fill=theme["quiet"], width=1)
    if visualizer_mode == "spectrum":
        gap = 4
        bar_width = max(4, int((width - gap * (bar_count + 1)) / bar_count))
        for index, level in enumerate(spectrum_levels):
            ratio = index / max(1, bar_count - 1)
            x1 = gap + index * (bar_width + gap)
            x2 = x1 + bar_width
            center_bias = 0.42 + 0.58 * (1.0 - abs(ratio - 0.5) * 2.0) ** 1.8
            shimmer = 0.92 + 0.08 * math.sin(phase + index * 0.7)
            lift = level * center_bias * shimmer * (height * 0.46)
            if lift < 1.2:
                lift = 1.2
            y1 = center - lift
            y2 = center + lift
            color = theme["bar"] if level > 0.04 and not paused else theme["quiet"]
            canvas.create_rectangle(x1, y1, x2, y2, fill=color, outline="")
    else:
        points = []
        fill_points = [(0, center)]
        gain = 2.4
        for index, sample in enumerate(waveform_points):
            ratio = index / max(1, waveform_count - 1)
            x = ratio * width
            envelope = 0.18 + 0.82 * (math.sin(math.pi * ratio) ** 0.65)
            y = center - clamp(sample * gain, -1.0, 1.0) * envelope * (height * 0.46)
            points.extend([x, y])
            fill_points.append((x, y))
        fill_points.append((width, center))
        fill_flat = [coord for point in fill_points for coord in point]
        color = theme["bar"] if wave_peak > 0.018 and not paused else theme["quiet"]
        if wave_peak > 0.018 and not paused:
            canvas.create_polygon(fill_flat, fill=color, outline="", stipple="gray25", smooth=True)
        canvas.create_line(points, fill=color, width=3, smooth=True, capstyle=tk.ROUND, joinstyle=tk.ROUND)

    root.after(80, update_ui)


root = tk.Tk(className="voice-to-text")
